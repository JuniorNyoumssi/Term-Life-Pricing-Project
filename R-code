# Define the example policy
issue_age <- 35
sex <- "Male"
smoking_status <- "Nonsmoker"
uw_class <- "Preferred"
term <- 20
face_amount <- 500000
product_type <- "Term20"

annual_improvement <- 0.01

# Create an empty table to store projected results
policy_projection <- data.frame(
  Duration = integer(),
  AttainedAge = integer(),
  MortalityRate = double(),
  LapseRate = double(),
  InforceProbability = double(),
  ExpectedDeaths = double(),
  ExpectedClaimCost = double(),
  ExpectedClaimExpense = double()
)

# Probability the policy is active at the start
# of the first policy year
inforce_probability <- 1

# Project each policy year
for (t in 1:term) {
  
  # 1. Calculate mortality for this duration
  mortality_result <- get_mortality_rate(
    issue_age = issue_age,
    duration = t,
    sex = sex,
    smoking_status = smoking_status,
    uw_class = uw_class,
    mortality_table = mortality_table,
    mortality_factors = mortality_factors,
    annual_improvement = annual_improvement
  )
  
  mortality_rate <-
    mortality_result$ProjectedMortality
  
  attained_age <-
    mortality_result$AttainedAge
  
  # 2. Find the lapse assumption for this year
  lapse_row <- lapse_basis[
    lapse_basis$ProductType == product_type &
      lapse_basis$Duration == t,
  ]
  
  if (nrow(lapse_row) != 1) {
    stop("Expected exactly one matching lapse assumption.")
  }
  
  lapse_rate <- lapse_row$Lapse_Base
  
  # 3. Calculate expected claims and claim expenses
  expected_deaths <-
    inforce_probability * mortality_rate
  
  expected_claim_cost <-
    expected_deaths * face_amount
  
  expected_claim_expense <-
    expected_deaths * 250
  
  # 4. Store this year's results
  policy_projection <- rbind(
    policy_projection,
    data.frame(
      Duration = t,
      AttainedAge = attained_age,
      MortalityRate = mortality_rate,
      LapseRate = lapse_rate,
      InforceProbability = inforce_probability,
      ExpectedDeaths = expected_deaths,
      ExpectedClaimCost = expected_claim_cost,
      ExpectedClaimExpense = expected_claim_expense
    )
  )
  
  # 5. Calculate the probability of remaining
  # in force at the start of the next year
  inforce_probability <-
    (inforce_probability-expected_deaths) * (1 - lapse_rate)
}

