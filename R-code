### Create a reusable numerical validation function
### We'll write a function that checks whether a value is:
### - Numeric.
### - Not missing (NA).
### - Finite (not Inf, -Inf, or NaN).
### - Positive or nonnegative, depending on the component.


validate_numeric <- function(x, allow_zero = TRUE) {
  
  if (length(x) != 1 || !is.numeric(x)) {
    return("INVALID")
  }
  
  if (is.na(x)) {
    return("MISSING")
  }
  
  if (!is.finite(x)) {
    return("INVALID")
  }
  
  if (allow_zero && x < 0) {
    return("INVALID")
  }
  
  if (!allow_zero && x <= 0) {
    return("INVALID")
  }
  
  return("PASS")
}


