## COMBINE EVERYTHING INTO ONE SINGLE FUNCTION


calculate_indicated_premium <- function(
    issue_age,
    sex,
    smoking_status,
    uw_class,
    term,
    face_amount,
    product_type,
    mortality_table,
    mortality_factors,
    lapse_basis,
    interest_rate = 0.04,
    annual_improvement = 0.01,
    initial_expense = 150,
    renewal_expense = 40,
    claim_expense_per_death = 250,
    expense_ratio = 0.15,
    target_profit_margin = 0.05,
    mortality_sensitivity = 1,
    lapse_sensitivity = 1
) {
  
  # 1. Validate the inputs
  if (length(issue_age) != 1 ||
      is.na(issue_age) ||
      issue_age != floor(issue_age) ||
      issue_age < 1) {
    stop("Issue age must be a positive integer.")
  }
  
  if (length(term) != 1 ||
      is.na(term) ||
      !term %in% c(10, 20)) {
    stop("Term must be 10 or 20 years.")
  }
  
  if (length(face_amount) != 1 ||
      is.na(face_amount) ||
      !is.finite(face_amount) ||
      face_amount <= 0) {
    stop("Face amount must be positive.")
  }
  
  if (length(interest_rate) != 1 ||
      is.na(interest_rate) ||
      !is.finite(interest_rate) ||
      interest_rate <= -1) {
    stop("Interest rate must be greater than -100%.")
  }
  
  if (length(lapse_sensitivity) != 1 ||
      is.na(lapse_sensitivity) ||
      !is.finite(lapse_sensitivity) ||
      lapse_sensitivity <= 0) {
    stop("Lapse sensitivity must be positive and finite.")
  }
  
  if (length(annual_improvement) != 1 ||
      is.na(annual_improvement) ||
      annual_improvement < 0 ||
      annual_improvement >= 1) {
    stop("Annual improvement must be between 0 and 1.")
  }
  
  if (expense_ratio < 0 ||
      target_profit_margin < 0 ||
      expense_ratio + target_profit_margin >= 1) {
    stop("Expense ratio and profit margin must be nonnegative and sum to less than 100%.")
  }
  
  if (length(mortality_sensitivity) != 1 ||
      is.na(mortality_sensitivity) ||
      !is.finite(mortality_sensitivity) ||
      mortality_sensitivity <= 0) {
    stop("Mortality sensitivity must be positive and finite.")
  }
  
  # 2. Initialize the projection
  policy_projection <- data.frame(
    Duration = seq_len(term),
    AttainedAge = integer(term),
    MortalityRate = double(term),
    LapseRate = double(term),
    InforceProbability = double(term),
    ExpectedDeaths = double(term),
    ExpectedClaimCost = double(term),
    ExpectedClaimExpense = double(term),
    DiscountFactor = double(term),
    PVExpectedClaimCost = double(term),
    PVExpectedClaimExpense = double(term),
    PVExpectedRenewalExpense = double(term)
  )
  
  inforce_probability <- 1
  
  # 3. Project each policy year
  for (t in seq_len(term)) {
    
    # Calculate mortality for the current duration
    mortality_result <- get_mortality_rate(
      issue_age = issue_age,
      duration = t,
      sex = sex,
      smoking_status = smoking_status,
      uw_class = uw_class,
      mortality_table = mortality_table,
      mortality_factors = mortality_factors,
      annual_improvement = annual_improvement
    )
    
    mortality_rate <-
      mortality_result$ProjectedMortality*mortality_sensitivity
    
    attained_age <-
      mortality_result$AttainedAge
    
    if (length(mortality_rate) != 1 ||
        is.na(mortality_rate) ||
        !is.finite(mortality_rate) ||
        mortality_rate < 0 ||
        mortality_rate > 1) {
      stop("Invalid mortality rate. Check the mortality table and factors.")
    }
    
    # Retrieve the lapse assumption for this duration
    lapse_row <- lapse_basis[
      lapse_basis$ProductType == product_type &
        lapse_basis$Duration == t,
    ]
    
    if (nrow(lapse_row) != 1 ||
        !"Lapse_Base" %in% names(lapse_row)) {
      stop("Expected exactly one matching lapse assumption.")
    }
    
    lapse_rate <- lapse_row$Lapse_Base * lapse_sensitivity
    
    if (is.na(lapse_rate) ||
        !is.finite(lapse_rate) ||
        lapse_rate < 0 ||
        lapse_rate > 1) {
      stop("Invalid lapse rate.")
    }
    
    # Expected deaths and claims during this year
    expected_deaths <-
      inforce_probability * mortality_rate
    
    expected_claim_cost <-
      expected_deaths * face_amount
    
    expected_claim_expense <-
      expected_deaths * claim_expense_per_death
    
    # Claims are paid at the end of the year
    discount_factor <-
      1 / (1 + interest_rate)^t
    
    # Renewal expenses are paid at the beginning
    # of years 2, 3, ..., term
    pv_renewal_expense <- if (t >= 2) {
      inforce_probability *
        renewal_expense /
        (1 + interest_rate)^(t - 1)
    } else {
      0
    }
    
    # Store this year's projected results
    policy_projection[t, "AttainedAge"] <-
      attained_age
    
    policy_projection[t, "MortalityRate"] <-
      mortality_rate
    
    policy_projection[t, "LapseRate"] <-
      lapse_rate
    
    policy_projection[t, "InforceProbability"] <-
      inforce_probability
    
    policy_projection[t, "ExpectedDeaths"] <-
      expected_deaths
    
    policy_projection[t, "ExpectedClaimCost"] <-
      expected_claim_cost
    
    policy_projection[t, "ExpectedClaimExpense"] <-
      expected_claim_expense
    
    policy_projection[t, "DiscountFactor"] <-
      discount_factor
    
    policy_projection[t, "PVExpectedClaimCost"] <-
      expected_claim_cost * discount_factor
    
    policy_projection[t, "PVExpectedClaimExpense"] <-
      expected_claim_expense * discount_factor
    
    policy_projection[t, "PVExpectedRenewalExpense"] <-
      pv_renewal_expense
    
    # Update in-force probability for the next year.
    # Deaths and lapses remove policies from future years.
    inforce_probability <-
      inforce_probability *
      (1 - mortality_rate) *
      (1 - lapse_rate)
  }
  
  # 4. Calculate present values
  pv_claims <- sum(
    policy_projection$PVExpectedClaimCost
  )
  
  pv_claim_expenses <- sum(
    policy_projection$PVExpectedClaimExpense
  )
  
  pv_initial_expense <- initial_expense
  
  pv_renewal_expenses <- sum(
    policy_projection$PVExpectedRenewalExpense
  )
  
  pv_total_costs <-
    pv_claims +
    pv_claim_expenses +
    pv_initial_expense +
    pv_renewal_expenses
  
  # 5. Calculate the present value factor for premiums.
  # Premiums are paid at the beginning of each year.
  premium_payment_factor <- sum(
    policy_projection$InforceProbability /
      (1 + interest_rate)^(
        policy_projection$Duration - 1
      )
  )
  
  # 6. Calculate the indicated annual premium
  premium_denominator <-
    premium_payment_factor *
    (1 - expense_ratio - target_profit_margin)
  
  if (premium_payment_factor <= 0 ||
      premium_denominator <= 0) {
    stop("Invalid premium calculation denominator.")
  }
  
  indicated_annual_premium <-
    pv_total_costs / premium_denominator
  
  # 7. Return the premium and supporting results
  list(
    indicated_annual_premium =
      indicated_annual_premium,
    
    pv_claims = pv_claims,
    
    pv_claim_expenses =
      pv_claim_expenses,
    
    pv_initial_expense =
      pv_initial_expense,
    
    pv_renewal_expenses =
      pv_renewal_expenses,
    
    pv_total_costs =
      pv_total_costs,
    
    premium_payment_factor =
      premium_payment_factor,
    
    projection =
      policy_projection
  )
}




