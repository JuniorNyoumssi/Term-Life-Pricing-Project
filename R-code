validate_premium_direction <- function(
    baseline_premium,
    alternative_premium,
    expected_direction
) {
  
  if (expected_direction == "increase") {
    
    passed <- alternative_premium > baseline_premium
    
  } else if (expected_direction == "decrease") {
    
    passed <- alternative_premium < baseline_premium
    
  } else {
    
    stop("Invalid expected direction.")
  }
  
  data.frame(
    BaselinePremium = baseline_premium,
    AlternativePremium = alternative_premium,
    ExpectedDirection = expected_direction,
    ActualChange = alternative_premium - baseline_premium,
    RelativeChange = alternative_premium / baseline_premium - 1,
    TestResult = ifelse(passed, "PASS", "FAIL")
  )
}



