### Step 2 — Build our reusable mortality lookup function

# Retrieve a mortality factor for a given characteristic
# This function retrieves the mortality factor from the mortality factor
# table using the match function to return the mortality factor for 
# that specific level
# Note: Match returns the row number of the first occurrence of the 
# value you are looking for



get_mortality_factor <- function(factor_name, level,
                                 mortality_factors) {
  
  factor_rows <- mortality_factors[
    mortality_factors$Factor == factor_name,
  ]
  
  factor_rows$MortalityFactor[
    match(level, factor_rows$Level)
  ]
}


# Calculate the adjusted mortality rate
# This function will retrieve the mortality rate based on the policy holder's
# attained age by matching it with the mortality table's age column 
# to retrieve the mortality rate qx , it works just like a VLOOKUP
# the mortality rate will then be used to calculate the improved mortality



get_mortality_rate <- function(
    issue_age,
    duration,
    sex,
    smoking_status,
    uw_class,
    mortality_table,
    mortality_factors,
    annual_improvement = 0.01) {
  
  # 1. Calculate attained age
  attained_age <- issue_age + duration - 1
  
  # 2. Look up base mortality at attained age
  age_index <- match(
    attained_age,
    mortality_table$Age
  )
  
  qx_base <- mortality_table$qx_Base[age_index]
  
  # 3. Retrieve the relevant mortality factors
  sex_factor <- get_mortality_factor(
    "Sex", sex, mortality_factors
  )
  
  smoking_factor <- get_mortality_factor(
    "SmokingStatus", smoking_status, mortality_factors
  )
  
  uw_factor <- get_mortality_factor(
    "UW_Class", uw_class, mortality_factors
  )
  
  # 4. Check that all lookups succeeded
  if (anyNA(c(qx_base, sex_factor,
              smoking_factor, uw_factor))) {
    stop("Missing age or mortality factor. Check the input values.")
  }
  
  # 5. Validate the improvement assumption
  if (any(annual_improvement < 0 |
          annual_improvement >= 1)) {
    stop("Annual improvement must be between 0 and 1.")
  }
  
  # 6. Apply risk factors
  qx_adjusted <- qx_base *
    sex_factor *
    smoking_factor *
    uw_factor
  
  # 7. Apply mortality improvement
  qx_projected <- qx_adjusted *
    (1 - annual_improvement)^(duration - 1)
  
  # 8. Return useful results
  data.frame(
    AttainedAge = attained_age,
    BaseMortality = qx_base,
    SexFactor = sex_factor,
    SmokingFactor = smoking_factor,
    UWFactor = uw_factor,
    ProjectedMortality = qx_projected
  )
}

